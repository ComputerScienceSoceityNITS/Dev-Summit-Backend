# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend origin (exact origin, no path)
CLIENT_URL=http://localhost:5173
# Production can list multiple exact origins, comma-separated:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://www.example.com

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/dev_summit_2026

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Google Identity Services (must match the frontend client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
